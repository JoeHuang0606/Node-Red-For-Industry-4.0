            "joe-rfid-decoder": "joe-rfid-decoder/joe-rfid-decoder.js",
            "joe-pressure-parser": "joe-pressure-parser/joe-pressure-parser.js",
            "joe-flow-parser": "joe-flow-parser/joe-flow-parser.js",
            "joe-ultrasonic-parser": "joe-ultrasonic-parser/joe-ultrasonic-parser.js",
            "joe-power-parser": "joe-power-parser/joe-power-parser.js",
            "mysql-extended": "mysql-extended/mysql-extended.js",
            "rfid-lazy": "rfid-lazy/rfid-lazy.js",
            "variable-change": "variable-change/variable-change.js",
            "node-red-ui_media_viewer": "node-red-ui_media_viewer/ui_media_viewer.js",
            "s7complus": "node-red-contrib-s7-plus/nodes/s7complus.js"
