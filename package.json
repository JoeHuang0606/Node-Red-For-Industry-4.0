{
    "name": "node-red-contrib-joe-tools",
    "version": "1.1.4",
    "repository": {
        "type": "git",
        "url": "https://github.com/JoeHuang0606/Node-Red-For-Industry-4.0.git"
    },
    "description": "Node-RED toolkit for industrial automation, sensor data parsing, RFID, S7 PLC, MySQL and utility tools.",
    "main": "modbus-ascii-packer/modbus-ascii-packer.js",
    "node-red": {
        "nodes": {
            "modbus-ascii-packer": "modbus-ascii-packer/modbus-ascii-packer.js",
